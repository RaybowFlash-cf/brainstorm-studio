{
  "version": 2,
  "builds": [
    {
      "src": "src/app/**/*.{ts,tsx}",
      "use": "@vercel/next"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/app/api/$1/route.ts"
    },
    {
      "src": "/voice",
      "dest": "/src/app/voice/page.tsx"
    },
    {
      "src": "/settings",
      "dest": "/src/app/settings/page.tsx"
    },
    {
      "src": "/(.*)",
      "dest": "/src/app/page.tsx"
    }
  ]
}
