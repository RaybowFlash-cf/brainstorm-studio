# Angelical AI — Environment Variables

# AI Provider (OpenCode Zen)
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=your-api-key-here
AI_MODEL=mimo-v2.5-free

# Fish Studio TTS
FISH_API_KEY=your-fish-studio-key-here

# Optional: GitHub Token for MCP
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: Brave Search API Key for MCP
# BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Database URL for MCP
# DATABASE_URL=postgresql://user:pass@localhost:5432/angelical
